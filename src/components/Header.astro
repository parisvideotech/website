---
import { SITE } from '@/data/site';

interface NavLink {
  href: string;
  label: string;
  external?: boolean;
}

const navLinks: NavLink[] = [
  { href: '/meetups-recents/', label: 'Meetups Récents' },
  { href: '/equipe/', label: 'Équipe' },
  { href: '/a-propos/', label: 'À propos' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label={`${SITE.name} — accueil`}>
      <img src="/images/logo.png" alt={SITE.name} width="178" height="36" />
    </a>

    <button
      id="nav-toggle"
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Ouvrir le menu"
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav id="primary-nav" class="header__nav" aria-label="Navigation principale">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Menu mobile — implémentation robuste :
  //   - State unique géré par classe `is-open` sur le <nav>
  //   - Fermeture auto sur navigation (clic sur lien)
  //   - Fermeture auto au resize vers desktop (évite menu coincé ouvert)
  //   - Fermeture auto au clic en dehors
  //   - Fermeture auto sur Escape
  //   - Synchronisation `aria-expanded` et `aria-label` à chaque changement

  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const nav = document.getElementById('primary-nav') as HTMLElement | null;

  if (toggle && nav) {
    const MOBILE_MQ = window.matchMedia('(max-width: 768px)');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      nav.classList.toggle('is-open', open);
      toggle.classList.toggle('is-active', open);
      document.body.classList.toggle('has-mobile-menu-open', open);
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    // Toggle au clic sur le burger
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    // Fermer si on clique sur un lien de la nav
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Fermer si on clique en dehors du menu (overlay)
    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      const target = e.target as Node;
      if (!nav.contains(target) && !toggle.contains(target)) {
        setOpen(false);
      }
    });

    // Fermer avec Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });

    // Au resize vers desktop, fermer le menu pour éviter un état hybride
    const handleViewportChange = (e: MediaQueryListEvent | MediaQueryList) => {
      if (!e.matches && isOpen()) setOpen(false);
    };
    MOBILE_MQ.addEventListener('change', handleViewportChange);
  }

  // Smooth scroll sur les ancres internes
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href || href === '#') return;

      const target = document.querySelector(href);
      if (!target) return;

      e.preventDefault();
      const offset = 80; // compensation hauteur du header fixe
      const top = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - offset;

      window.scrollTo({
        top,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
      });
    });
  });
</script>

<style>
  .header {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header__inner {
    width: var(--content-width);
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    color: inherit;
  }

  .header__logo img {
    height: 36px;
    width: auto;
    /* Logo dispo en couleur sur fond rouge — pas top de contraste,
       on inverse en blanc avec un filtre pour Phase 1.
       À remplacer par un SVG dédié monochrome blanc en cours de phase. */
    filter: brightness(0) invert(1);
  }

  .header__toggle {
    display: none; /* visible en mobile */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    color: inherit;
  }

  .header__toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: currentColor;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .header__toggle.is-active .header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header__toggle.is-active .header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .header__toggle.is-active .header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header__nav a {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: inherit;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    background-color: rgba(255, 255, 255, 0.15);
    text-decoration: none;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .header__toggle {
      display: flex;
    }

    /* Le menu mobile est un panneau qui glisse depuis le haut. Il est en
       `position: fixed` (et non `absolute`) pour ne pas dépendre du
       containing block du header sticky, qui est buggé sur certains
       navigateurs (Safari + Chrome quand on resize). */
    .header__nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      background-color: var(--color-primary);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: transform 250ms ease, opacity 200ms ease, visibility 0s linear 250ms;
      z-index: var(--z-header);
    }

    .header__nav.is-open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      transition: transform 250ms ease, opacity 200ms ease, visibility 0s;
    }

    .header__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2) 0;
    }

    .header__nav a {
      display: block;
      padding: var(--space-4) var(--space-6);
      border-radius: 0;
      font-size: var(--font-size-base);
    }

    .header__nav a:hover,
    .header__nav a[aria-current='page'] {
      background-color: rgba(255, 255, 255, 0.12);
    }
  }

  /* Empêche le scroll du body quand le menu mobile est ouvert (UX standard). */
  :global(body.has-mobile-menu-open) {
    overflow: hidden;
  }

  @media (min-width: 769px) {
    /* Sur desktop, le scroll-lock ne s'applique pas (le menu n'est pas en overlay). */
    :global(body.has-mobile-menu-open) {
      overflow: auto;
    }
  }
</style>
