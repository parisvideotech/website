---
import { SITE } from '@/data/site';
import SocialIcon from './SocialIcon.astro';

const currentYear = new Date().getFullYear();
---

<!-- Bloc "Inscrivez-vous" — reprise du thème actuel. -->
<section class="subscribe" aria-label="S'inscrire aux prochains meetups">
  <div class="subscribe__inner">
    <h2 class="subscribe__title">Inscrivez-vous</h2>
    <a
      class="subscribe__link"
      href={SITE.social.meetup}
      target="_blank"
      rel="noopener noreferrer"
    >
      www.meetup.com/paris-video-tech
    </a>
  </div>
</section>

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__columns">
      <!-- Colonne 1 : identité de marque -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={`${SITE.name} — accueil`}>
          <img src="/images/logo2026.svg" alt={SITE.name} width="178" height="36" />
        </a>
        <p class="footer__tagline">{SITE.tagline}</p>
        <ul class="footer__social">
          <li>
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Page LinkedIn de Paris Video Tech"
            >
              <SocialIcon name="linkedin" />
            </a>
          </li>
          <li>
            <a
              href={SITE.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Page X (Twitter) de Paris Video Tech"
            >
              <SocialIcon name="twitter" />
            </a>
          </li>
          <li>
            <a
              href={SITE.social.meetup}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Page Meetup de Paris Video Tech"
            >
              <SocialIcon name="meetup" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonne 2 : navigation -->
      <nav class="footer__column" aria-label="Navigation de pied de page">
        <h4 class="footer__heading">Découvrir</h4>
        <ul>
          <li><a href="/meetups-recents/">Meetups récents</a></li>
          <li><a href="/equipe/">Équipe</a></li>
          <li><a href="/sponsors/">Sponsors</a></li>
          <li><a href="/a-propos/">À propos</a></li>
        </ul>
      </nav>

      <!-- Colonne 3 : contact et action -->
      <div class="footer__column">
        <h4 class="footer__heading">Contact</h4>
        <ul>
          <li>
            <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
          </li>
          <li>
            <a href={SITE.donations.helloasso} target="_blank" rel="noopener noreferrer">
              Nous soutenir
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonne 4 : légal -->
      <div class="footer__column">
        <h4 class="footer__heading">Légal</h4>
        <ul>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/politique-de-confidentialite/">Confidentialité</a></li>
        </ul>
      </div>
    </div>

    <p class="footer__legal">
      &copy; {currentYear} {SITE.name}. Association loi 1901.
    </p>
  </div>
</footer>

<style>
  .subscribe {
    background-color: var(--color-text);
    color: var(--color-text-inverse);
    padding-block: var(--space-8);
    text-align: center;
  }

  .subscribe__title {
    color: var(--color-text-inverse);
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-3);
  }

  .subscribe__link {
    color: var(--color-text-inverse);
    text-decoration: underline;
    font-size: var(--font-size-lg);
  }

  .footer {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    padding-block: var(--space-12) var(--space-6);
  }

  .footer__inner {
    width: var(--content-width);
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  @media (max-width: 900px) {
    .footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 540px) {
    .footer__columns {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__logo img {
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__tagline {
    font-size: var(--font-size-sm);
    opacity: 0.9;
    max-width: 28ch;
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-fast);
    color: var(--color-on-primary);
  }

  .footer__social a:hover {
    background-color: rgba(255, 255, 255, 0.18);
    text-decoration: none;
  }

  .footer__column {
    display: flex;
    flex-direction: column;
  }

  .footer__heading {
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--space-3);
    opacity: 0.95;
  }

  .footer__column ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__column a {
    color: var(--color-on-primary);
    font-size: var(--font-size-sm);
    opacity: 0.92;
    transition: opacity var(--transition-fast);
  }

  .footer__column a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-4);
    text-align: center;
    font-size: var(--font-size-xs);
    opacity: 0.85;
  }
</style>
