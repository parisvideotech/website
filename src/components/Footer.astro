---
import { SITE } from '@/data/site';
import SocialIcon from './SocialIcon.astro';

const currentYear = new Date().getFullYear();
---

<!-- Bloc "Inscrivez-vous" — reprise du thème actuel. -->
<section class="subscribe" aria-label="S'inscrire aux prochains meetups">
  <div class="subscribe__inner">
    <h2 class="subscribe__title">Inscrivez-vous</h2>
    <a
      class="subscribe__link"
      href={SITE.social.meetup}
      target="_blank"
      rel="noopener noreferrer"
    >
      www.meetup.com/paris-video-tech
    </a>
  </div>
</section>

<footer class="footer">
  <div class="footer__inner">
    <a href="/" class="footer__logo" aria-label={`${SITE.name} — accueil`}>
      <img src="/images/logo.png" alt={SITE.name} width="178" height="36" />
    </a>

    <div class="footer__info">
      <div class="footer__block">
        <h4>Contact</h4>
        <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
      </div>

      <div class="footer__block">
        <h4>Suivez-nous</h4>
        <ul class="footer__social">
          <li>
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Page LinkedIn de Paris Video Tech"
            >
              <SocialIcon name="linkedin" />
            </a>
          </li>
          <li>
            <a
              href={SITE.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Page X (Twitter) de Paris Video Tech"
            >
              <SocialIcon name="twitter" />
            </a>
          </li>
          <li>
            <a
              href={SITE.social.meetup}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Page Meetup de Paris Video Tech"
            >
              <SocialIcon name="meetup" />
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer__nav" aria-label="Navigation de pied de page">
        <ul>
          <li><a href="/meetups-recents/">Meetups Récents</a></li>
          <li><a href="/equipe/">Équipe</a></li>
          <li><a href="/a-propos/">À propos</a></li>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/politique-de-confidentialite/">Confidentialité</a></li>
        </ul>
      </nav>
    </div>

    <p class="footer__legal">
      &copy; {currentYear} {SITE.name}. Association loi 1901.
    </p>
  </div>
</footer>

<style>
  .subscribe {
    background-color: var(--color-text);
    color: var(--color-text-inverse);
    padding-block: var(--space-8);
    text-align: center;
  }

  .subscribe__title {
    color: var(--color-text-inverse);
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-3);
  }

  .subscribe__link {
    color: var(--color-text-inverse);
    text-decoration: underline;
    font-size: var(--font-size-lg);
  }

  .footer {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    padding-block: var(--space-12) var(--space-6);
  }

  .footer__inner {
    width: var(--content-width);
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    gap: var(--space-8);
  }

  .footer__logo img {
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-8);
  }

  .footer__block h4 {
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--space-2);
  }

  .footer__block a {
    color: var(--color-on-primary);
  }

  .footer__block a:hover {
    text-decoration: underline;
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-fast);
  }

  .footer__social a:hover {
    background-color: rgba(255, 255, 255, 0.15);
    text-decoration: none;
  }

  .footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__nav a {
    color: var(--color-on-primary);
    font-size: var(--font-size-sm);
  }

  .footer__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-4);
    text-align: center;
    font-size: var(--font-size-xs);
    opacity: 0.85;
  }
</style>
