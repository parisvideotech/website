---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MeetupCard from '@/components/MeetupCard.astro';
import { getCollection } from 'astro:content';

const meetups = (
  await getCollection('meetups', ({ data }) => !data.draft && data.status !== 'draft')
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Meetups Récents"
  description="L'ensemble des meetups Paris Video Tech, du plus récent au plus ancien."
>
  <section class="meetups">
    <div class="container">
      <h1>Nos meetups récents</h1>
      <p class="meetups__intro">
        Tous les meetups organisés par Paris Video Tech, du plus récent au plus ancien.
      </p>

      {
        meetups.length === 0 ? (
          <p class="meetups__empty">
            La liste sera disponible une fois la migration depuis WordPress effectuée.
          </p>
        ) : (
          <div class="meetups__grid">
            {meetups.map((meetup) => <MeetupCard meetup={meetup} />)}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .meetups {
    padding-block: var(--space-16);
  }

  .meetups h1 {
    margin-bottom: var(--space-3);
  }

  .meetups__intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-12);
    max-width: 65ch;
  }

  .meetups__empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .meetups__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }
</style>
